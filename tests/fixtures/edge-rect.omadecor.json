{
  "schemaVersion": 1,
  "kind": "omadecor-decoration",
  "id": "omadecor/edge-rect-test",
  "name": "Edge and Rect Test",
  "version": "1.0.0",
  "requires": [
    "primitive.edge",
    "primitive.rect",
    "paint.solid",
    "state.focused"
  ],
  "parameters": {
    "markerWidth": {
      "type": "number",
      "label": "Marker width",
      "unit": "px",
      "default": 40,
      "min": 8,
      "max": 80,
      "step": 4
    },
    "markerColor": {
      "type": "color",
      "label": "Marker color",
      "default": "#00ffff"
    },
    "enabled": {
      "type": "boolean",
      "label": "Enabled",
      "default": true
    },
    "mode": {
      "type": "enum",
      "label": "Mode",
      "default": "wide",
      "options": ["wide", "compact"]
    }
  },
  "palette": {},
  "appearance": { "opacity": 1 },
  "layers": [
    {
      "id": "top-line",
      "type": "edge",
      "side": "top",
      "thickness": 4,
      "placement": "outside",
      "paint": { "type": "solid", "color": "#ff00ff" }
    },
    {
      "id": "top-marker",
      "type": "rect",
      "x": { "rel": 0.5, "px": -20 },
      "y": -12,
      "width": { "ref": "param.markerWidth" },
      "height": 6,
      "paint": { "type": "solid", "color": { "ref": "param.markerColor" } }
    }
  ],
  "variants": [
    {
      "when": { "focused": false },
      "patch": { "theme": { "opacity": 0.35 } }
    }
  ]
}
