{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZA512/OmaDecor/schemas/effect-pack-v1.schema.json",
  "title": "OmaDecor Effect Pack V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "version",
    "description",
    "source",
    "compatibility",
    "shaders",
    "requires",
    "duration",
    "renderingCost",
    "parameters",
    "presets"
  ],
  "properties": {
    "$schema": { "type": "string", "maxLength": 240 },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "omadecor-effect-pack" },
    "id": { "$ref": "#/$defs/packId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "$ref": "#/$defs/version" },
    "description": { "type": "string", "maxLength": 512 },
    "source": { "$ref": "#/$defs/source" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "shaders": { "$ref": "#/$defs/shaders" },
    "requires": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "duration": { "$ref": "#/$defs/duration" },
    "renderingCost": { "enum": ["low", "medium", "high"] },
    "parameters": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/parameter" }
    },
    "presets": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/localId" },
      "additionalProperties": {
        "type": "object",
        "maxProperties": 64,
        "propertyNames": { "$ref": "#/$defs/localId" },
        "additionalProperties": { "$ref": "#/$defs/parameterValue" }
      }
    },
    "preview": { "$ref": "#/$defs/relativeFile" }
  },
  "$defs": {
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "relativeFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "event": {
      "enum": [
        "open", "close", "move", "resize", "workspace", "focus", "unfocus",
        "urgent", "float", "tile", "fullscreen-enter", "fullscreen-exit"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "project", "authors", "license"],
      "properties": {
        "type": { "enum": ["native", "ported", "adapted", "external"] },
        "project": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "portAuthors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "license": { "type": "string", "minLength": 1, "maxLength": 64 },
        "adaptationNotes": { "type": "string", "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["ported", "adapted", "external"] } } },
          "then": { "required": ["url", "revision"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["ported", "adapted"] } } },
          "then": { "required": ["portAuthors", "adaptationNotes"] }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFormat", "events"],
      "properties": {
        "sourceFormat": { "enum": ["native", "niri", "bmw"] },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "shaders": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 12,
      "additionalProperties": false,
      "properties": {
        "open": { "$ref": "#/$defs/relativeFile" },
        "close": { "$ref": "#/$defs/relativeFile" },
        "move": { "$ref": "#/$defs/relativeFile" },
        "resize": { "$ref": "#/$defs/relativeFile" },
        "workspace": { "$ref": "#/$defs/relativeFile" },
        "focus": { "$ref": "#/$defs/relativeFile" },
        "unfocus": { "$ref": "#/$defs/relativeFile" },
        "urgent": { "$ref": "#/$defs/relativeFile" },
        "float": { "$ref": "#/$defs/relativeFile" },
        "tile": { "$ref": "#/$defs/relativeFile" },
        "fullscreen-enter": { "$ref": "#/$defs/relativeFile" },
        "fullscreen-exit": { "$ref": "#/$defs/relativeFile" }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMs", "minMs", "maxMs"],
      "properties": {
        "defaultMs": { "type": "number", "minimum": 0, "maximum": 5000 },
        "minMs": { "type": "number", "minimum": 0, "maximum": 5000 },
        "maxMs": { "type": "number", "minimum": 0, "maximum": 5000 }
      }
    },
    "parameterValue": {
      "oneOf": [
        { "type": "number" },
        { "type": "boolean" },
        { "type": "string", "maxLength": 128 }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "default"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "enum": ["float", "int", "boolean", "color", "enum"] },
        "default": { "$ref": "#/$defs/parameterValue" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    }
  }
}
